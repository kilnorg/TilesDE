import QtQuick
import FlowShell

// TilesDE Start page: scrollable 4-column tile grid packed row by row from a ListModel.
// Edit mode (long press): tiles shrink, unpin (x) + resize buttons, drag to reorder with live reflow,
// tap background (or exitEdit()) leaves. Turnstile in/out. Pull-down at the top is NOT handled here (Action Centre).
Item {
    id: root

    // ---- public API ----
    signal launched(string name, rect r, bool real)
    signal appsRequested()
    property bool editing: false
    property real pagerP: 0                    // 0 = start page, 1 = all apps (drives the tile fly-out)
    property int topInset: 48                  // status bar
    property int bottomInset: 96               // nav bar
    property bool flipsOn: true                // host can pause live flips
    readonly property bool exiting: _exiting
    property alias model: tileModel
    function enterEdit() {
        if (editing) return
        editing = true
        _editAt = Date.now()
    }
    function exitEdit() { editing = false; dragIndex = -1 }
    function playEnter() { _exiting = false; enterRequested() }
    function playExit() { _exiting = true; exitRequested() }
    function unpin(i) { if (i >= 0 && i < tileModel.count) tileModel.remove(i) }
    function pinApp(name) {
        for (let i = 0; i < tileModel.count; i++) if (tileModel.get(i).name === name) return false
        const g = name.toLowerCase()
        tileModel.append(mk(name, glyphs.indexOf(g) >= 0 ? g : "grid", "medium", false, "", "", "", 0))
        flick.contentY = Math.max(flick.contentY, flick.contentHeight - flick.height + flick.bottomMargin)
        return true
    }
    function resize(i) {
        if (i < 0 || i >= tileModel.count) return
        const s = tileModel.get(i).size
        tileModel.setProperty(i, "size", s === "small" ? "medium" : (s === "medium" ? "wide" : "small"))
    }

    // ---- internals ----
    property bool _exiting: false
    property double _editAt: 0
    property int dragIndex: -1
    property var dragCell: null
    property point dragVp: Qt.point(0, 0)      // pointer in viewport coords
    property point dragGrab: Qt.point(0, 0)    // pointer offset from tile centre
    property double _lastMove: 0
    property var layout: []
    property real rowsHeight: 0
    signal enterRequested()
    signal exitRequested()

    readonly property var glyphs: ["phone", "message", "mail", "calendar", "clock", "photos", "music", "maps", "notes", "files", "weather",
        "terminal", "store", "camera", "settings", "people", "browser", "wallet", "noxal", "video"]

    function mk(name, glyph, size, live, big, l1, l2, badge) {
        return { name: name, label: name, glyph: glyph, size: size, live: live, big: big, line1: l1, line2: l2, badge: badge }
    }

    ListModel { id: tileModel }

    Component.onCompleted: {
        const t = [
            mk("Weather", "weather", "wide", true, "22°", "Sunny", "H 24°  L 16°"),
            mk("Photos", "photos", "medium", true, "", "Yesterday", "42 new photos"),
            mk("Mail", "mail", "medium", true, "3", "Design review", "Inbox, 3 unread"),
            mk("Calendar", "calendar", "wide", true, Qt.formatDate(new Date(), "d"), Qt.formatDate(new Date(), "dddd"), "Design review, 10:30"),
            mk("Store", "store", "medium", true, "", "Updates", "5 apps ready"),
            mk("People", "people", "medium", true, "", "Sam", "Sent you a photo"),
            mk("Phone", "phone", "small", false, "", "", "", 2),
            mk("Camera", "camera", "small", false, "", "", "", 0),
            mk("Settings", "settings", "small", false, "", "", "", 0),
            mk("Music", "music", "small", false, "", "", "", 0),
            mk("Maps", "maps", "small", false, "", "", "", 0),
            mk("Notes", "notes", "small", false, "", "", "", 0),
            mk("Clock", "clock", "small", false, "", "", "", 0),
            mk("Files", "files", "small", false, "", "", "", 0),
            mk("Messages", "message", "medium", true, "4", "Alex", "Are you coming tonight?", 4),
            mk("Browser", "browser", "small", false, "", "", "", 0),
            mk("Wallet", "wallet", "small", false, "", "", "", 0),
            mk("Terminal", "terminal", "small", false, "", "", "", 0),
            mk("Noxal", "noxal", "small", false, "", "", "", 0),
            mk("Photos", "photos", "large", true, "", "Photos hub", "Memories from last summer")
        ]
        for (let i = 0; i < t.length; i++) tileModel.append(t[i])
        computeLayout()
    }

    function cellsOf(sz) {
        return sz === "small" ? [1, 1] : (sz === "medium" ? [2, 2] : (sz === "wide" ? [4, 2] : [4, 4]))
    }
    // first-fit packing on a 4-column occupancy grid
    function computeLayout() {
        if (width <= 0) return
        const u = Theme.tileUnit(width), g = Theme.tileGap, m = Theme.pageMargin
        const occ = []
        function free(r, c, cw, ch) {
            for (let rr = r; rr < r + ch; rr++)
                for (let cc = c; cc < c + cw; cc++) if (occ[rr] && occ[rr][cc]) return false
            return true
        }
        const out = []
        let rows = 0
        for (let i = 0; i < tileModel.count; i++) {
            const sz = tileModel.get(i).size
            const cs = cellsOf(sz), cw = cs[0], ch = cs[1]
            let done = false
            for (let r = 0; !done; r++) {
                for (let c = 0; c <= 4 - cw && !done; c++) {
                    if (!free(r, c, cw, ch)) continue
                    for (let rr = r; rr < r + ch; rr++) {
                        if (!occ[rr]) occ[rr] = [false, false, false, false]
                        for (let cc = c; cc < c + cw; cc++) occ[rr][cc] = true
                    }
                    out.push({ x: m + c * (u + g), y: r * (u + g), w: Theme.tileW(sz, width), h: Theme.tileH(sz, width), row: r, col: c })
                    rows = Math.max(rows, r + ch)
                    done = true
                }
            }
        }
        rowsHeight = rows * (u + g)
        layout = out
    }
    onWidthChanged: computeLayout()
    Connections {
        target: tileModel
        function onRowsInserted() { root.computeLayout() }
        function onRowsRemoved() { root.computeLayout() }
        function onRowsMoved() { root.computeLayout() }
        function onDataChanged() { root.computeLayout() }
    }

    function updateDrag() {
        const c = root.dragCell
        if (!c || root.dragIndex < 0) return
        const cx = root.dragVp.x - root.dragGrab.x
        const cy = root.dragVp.y + flick.contentY - root.dragGrab.y
        c.dragX = cx - c.width / 2
        c.dragY = cy - c.height / 2
        const now = Date.now()
        if (now - root._lastMove < 160) return
        for (let j = 0; j < root.layout.length; j++) {
            if (j === root.dragIndex) continue
            const L = root.layout[j]
            if (cx > L.x + L.w * 0.2 && cx < L.x + L.w * 0.8 && cy > L.y + L.h * 0.2 && cy < L.y + L.h * 0.8) {
                const from = root.dragIndex
                tileModel.move(from, j, 1)
                root.dragIndex = j
                root._lastMove = now
                break
            }
        }
    }
    Timer {
        interval: 16; repeat: true; running: root.dragIndex >= 0
        onTriggered: {
            const y = root.dragVp.y
            let d = 0
            if (y < root.topInset + 80) d = -10
            else if (y > flick.height - root.bottomInset - 60) d = 10
            if (d !== 0) {
                const lo = -flick.topMargin
                const hi = Math.max(lo, flick.contentHeight - flick.height + flick.bottomMargin)
                flick.contentY = Math.max(lo, Math.min(hi, flick.contentY + d))
                root.updateDrag()
            }
        }
    }

    Rectangle { anchors.fill: parent; color: Theme.pageBg }

    Flickable {
        id: flick
        anchors.fill: parent
        topMargin: root.topInset + 6
        bottomMargin: root.bottomInset + 70
        contentWidth: width
        contentHeight: content.height
        interactive: root.dragIndex < 0
        boundsBehavior: Flickable.StopAtBounds
        flickableDirection: Flickable.VerticalFlick
        Component.onCompleted: contentY = -topMargin
        onMovingChanged: Theme.scrollTick++

        Item {
            id: content
            width: flick.width
            height: root.rowsHeight + 8

            // background tap leaves edit mode
            MouseArea {
                anchors.fill: parent; z: -1
                onClicked: if (root.editing) root.exitEdit()
            }

            Repeater {
                model: tileModel
                delegate: Item {
                    id: cell
                    required property int index
                    required property string name
                    required property string label
                    required property string glyph
                    required property string size
                    required property bool live
                    required property string big
                    required property string line1
                    required property string line2
                    required property int badge

                    readonly property var L: (root.layout.length > index) ? root.layout[index] : null
                    property bool dragging: false
                    property real dragX: 0
                    property real dragY: 0
                    property real enterP: 0
                    readonly property real stag: L ? Math.min(0.5, L.row * 0.08 + L.col * 0.04) : 0
                    readonly property real pagerAng: Math.max(0, Math.min(1, root.pagerP * 1.5 - stag)) * 90
                    readonly property real turn: -((1 - enterP) * 90 + pagerAng)

                    x: dragging ? dragX : (L ? L.x : 0)
                    y: dragging ? dragY : (L ? L.y : 0)
                    width: L ? L.w : 0
                    height: L ? L.h : 0
                    visible: L !== null && Math.abs(turn) < 89.5
                    z: dragging ? 10 : 0
                    transformOrigin: Item.Center
                    scale: root.editing ? (dragging ? 1.04 : 0.88) : 1
                    Behavior on x { enabled: !cell.dragging && !Theme.reduceMotion && cell.enterP >= 1; NumberAnimation { duration: 240; easing.type: Easing.OutCubic } }
                    Behavior on y { enabled: !cell.dragging && !Theme.reduceMotion && cell.enterP >= 1; NumberAnimation { duration: 240; easing.type: Easing.OutCubic } }
                    Behavior on width { enabled: !Theme.reduceMotion; NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
                    Behavior on height { enabled: !Theme.reduceMotion; NumberAnimation { duration: 200; easing.type: Easing.OutCubic } }
                    Behavior on scale { enabled: !Theme.reduceMotion; NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
                    transform: Rotation {
                        origin.x: 0; origin.y: cell.height / 2
                        axis { x: 0; y: 1; z: 0 }
                        angle: cell.turn
                    }

                    function playIn() {
                        if (Theme.reduceMotion) { enterP = 1; return }
                        enterAnim.stop()
                        enterP = 0
                        enterAnim.restart()
                    }
                    function playOut() {
                        if (Theme.reduceMotion) { enterP = 0; return }
                        enterAnim.stop()
                        exitAnim.restart()
                    }
                    Component.onCompleted: playIn()
                    Connections {
                        target: root
                        function onEnterRequested() { cell.playIn() }
                        function onExitRequested() { cell.playOut() }
                    }
                    SequentialAnimation {
                        id: enterAnim
                        PauseAnimation { duration: cell.L ? Math.min(600, cell.L.row * 70 + cell.L.col * 35) : 0 }
                        NumberAnimation { target: cell; property: "enterP"; from: 0; to: 1; duration: Theme.turnstileMs + 80; easing.type: Easing.OutCubic }
                    }
                    SequentialAnimation {
                        id: exitAnim
                        PauseAnimation { duration: cell.L ? Math.min(400, cell.L.row * 45 + cell.L.col * 25) : 0 }
                        NumberAnimation { target: cell; property: "enterP"; to: 0; duration: Theme.turnstileMs; easing.type: Easing.InCubic }
                    }

                    MetroTile {
                        id: tile
                        anchors.fill: parent
                        size: cell.size
                        label: cell.label
                        glyph: cell.glyph
                        live: cell.live
                        index: cell.index
                        screenW: root.width
                        flat: root.editing
                        flipEnabled: root.flipsOn && !root.editing && !root._exiting && cell.enterP >= 1
                        onClicked: (r) => {
                            if (root.editing || Date.now() - root._editAt < 400) return
                            root.launched(cell.name, r, false)
                            root.playExit()
                        }
                        onPressAndHold: root.enterEdit()

                        // live back face
                        Loader {
                            anchors.fill: parent
                            active: cell.live
                            sourceComponent: backComp
                        }
                    }

                    // numeric badge (front face only)
                    Text {
                        visible: cell.badge > 0 && !root.editing && tile.flipAngle === 0
                        anchors { right: parent.right; top: parent.top; rightMargin: 9; topMargin: 4 }
                        text: cell.badge
                        color: Theme.tileText
                        font.family: Theme.font; font.weight: Font.Light
                        font.pixelSize: cell.size === "small" ? 26 : 34
                    }

                    // edit mode: drag surface
                    MouseArea {
                        id: dragMa
                        anchors.fill: parent
                        enabled: root.editing
                        visible: root.editing
                        z: 5
                        preventStealing: true
                        property bool moved: false
                        property point pressPt
                        onPressed: (m) => {
                            moved = false
                            pressPt = Qt.point(m.x, m.y)
                        }
                        onPositionChanged: (m) => {
                            if (!pressed) return
                            const vp = dragMa.mapToItem(flick.parent, m.x, m.y)
                            if (!moved) {
                                if (Math.abs(m.x - pressPt.x) + Math.abs(m.y - pressPt.y) < 12) return
                                moved = true
                                const p0 = dragMa.mapToItem(content, pressPt.x, pressPt.y)
                                root.dragGrab = Qt.point(p0.x - (cell.x + cell.width / 2), p0.y - (cell.y + cell.height / 2))
                                cell.dragX = cell.x; cell.dragY = cell.y
                                cell.dragging = true
                                root.dragCell = cell
                                root.dragIndex = cell.index
                            }
                            root.dragVp = Qt.point(vp.x, vp.y)
                            root.dragIndex = cell.index
                            root.updateDrag()
                        }
                        function finish() {
                            if (moved) { cell.dragging = false; root.dragIndex = -1; root.dragCell = null }
                            moved = false
                        }
                        onReleased: finish()
                        onCanceled: finish()
                    }

                    // edit mode: unpin
                    Rectangle {
                        id: unpinBtn
                        visible: root.editing && !cell.dragging
                        z: 10
                        readonly property int d: cell.size === "small" ? 28 : 36
                        width: d; height: d; radius: d / 2
                        anchors { right: parent.right; top: parent.top; rightMargin: 4; topMargin: 4 }
                        color: "#f2f2f2"
                        TileGlyph { anchors.centerIn: parent; size: Math.round(parent.d * 0.55); name: "close"; color: "#111111"; stroke: 2.4 }
                        MouseArea { anchors.fill: parent; anchors.margins: -6; onClicked: root.unpin(cell.index) }
                    }
                    // edit mode: resize toggle (small -> medium -> wide -> small)
                    Rectangle {
                        id: sizeBtn
                        visible: root.editing && !cell.dragging
                        z: 10
                        readonly property int d: cell.size === "small" ? 28 : 36
                        width: d; height: d; radius: d / 2
                        anchors { right: parent.right; bottom: parent.bottom; rightMargin: 4; bottomMargin: 4 }
                        color: "#f2f2f2"
                        Canvas {
                            anchors.fill: parent
                            onPaint: {
                                const ctx = getContext("2d")
                                ctx.clearRect(0, 0, width, height)
                                ctx.strokeStyle = "#111111"; ctx.lineWidth = 2.2; ctx.lineCap = "round"; ctx.lineJoin = "round"
                                const w = width, h = height
                                ctx.beginPath()
                                ctx.moveTo(w * 0.32, h * 0.68); ctx.lineTo(w * 0.68, h * 0.32)
                                ctx.moveTo(w * 0.32, h * 0.52); ctx.lineTo(w * 0.32, h * 0.68); ctx.lineTo(w * 0.48, h * 0.68)
                                ctx.moveTo(w * 0.52, h * 0.32); ctx.lineTo(w * 0.68, h * 0.32); ctx.lineTo(w * 0.68, h * 0.48)
                                ctx.stroke()
                            }
                        }
                        MouseArea { anchors.fill: parent; anchors.margins: -6; onClicked: root.resize(cell.index) }
                    }

                    // live back-face content
                    Component {
                        id: backComp
                        Item {
                            Text {
                                visible: cell.big !== ""
                                anchors { left: parent.left; top: parent.top; leftMargin: 10; topMargin: cell.size === "large" ? 12 : 4 }
                                text: cell.big
                                color: Theme.tileText
                                font.family: Theme.font; font.weight: Font.Light
                                font.pixelSize: cell.size === "large" ? 120 : (cell.size === "small" ? 40 : 76)
                            }
                            Column {
                                anchors { left: parent.left; bottom: parent.bottom; right: parent.right; leftMargin: 10; rightMargin: 10; bottomMargin: 8 }
                                spacing: 1
                                Text { width: parent.width; text: cell.line1; elide: Text.ElideRight; color: Theme.tileText; font.family: Theme.font; font.pixelSize: 17; font.weight: Font.Normal; visible: text !== "" }
                                Text { width: parent.width; text: cell.line2; elide: Text.ElideRight; color: Theme.tileText; opacity: 0.85; font.family: Theme.font; font.pixelSize: 14; font.weight: Font.Light; visible: text !== "" }
                            }
                        }
                    }
                }
            }
        }
    }

    // "all apps" arrow, bottom right
    Item {
        id: arrowBtn
        width: 48; height: 48
        anchors { right: parent.right; rightMargin: 16; bottom: parent.bottom; bottomMargin: root.bottomInset + 12 }
        opacity: root.editing ? 0 : Math.max(0, 1 - root.pagerP * 2)
        visible: opacity > 0.01
        Behavior on opacity { enabled: !Theme.reduceMotion; NumberAnimation { duration: 150 } }
        scale: arrowMa.pressed ? 0.92 : 1
        Behavior on scale { enabled: !Theme.reduceMotion; NumberAnimation { duration: Theme.pressMs } }
        Rectangle { anchors.fill: parent; radius: 24; color: "transparent"; border.width: 2; border.color: Theme.tileText }
        Canvas {
            anchors.fill: parent
            onPaint: {
                const ctx = getContext("2d")
                ctx.clearRect(0, 0, width, height)
                ctx.strokeStyle = "#ffffff"; ctx.lineWidth = 2.6; ctx.lineCap = "round"; ctx.lineJoin = "round"
                ctx.beginPath()
                ctx.moveTo(width * 0.30, height * 0.5); ctx.lineTo(width * 0.70, height * 0.5)
                ctx.moveTo(width * 0.52, height * 0.30); ctx.lineTo(width * 0.72, height * 0.5); ctx.lineTo(width * 0.52, height * 0.70)
                ctx.stroke()
            }
        }
        MouseArea { id: arrowMa; anchors.fill: parent; anchors.margins: -8; onClicked: root.appsRequested() }
    }
}
